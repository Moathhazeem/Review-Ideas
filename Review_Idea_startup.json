d>\n                    <td style=\"padding: 10px 5px; border-bottom: 1px solid #f3f4f6; text-align: left;\" dir=\"ltr\">\n                        <span style=\"display: inline-block; background-color: ${score.value >= 80 ? '#10b981' : score.value >= 60 ? '#f59e0b' : '#ef4444'}; color: white; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: bold;\">\n                            ${score.value} / 100 - ${score.label}\n                        </span>\n                    </td>\n                </tr>\n                `).join('') }}\n            </table>\n\n            <!-- نقاط القوة والضعف -->\n            <table width=\"100%\" style=\"border-collapse: collapse; margin-top: 30px;\">\n                <tr>\n                    <td width=\"50%\" style=\"vertical-align: top; padding-left: 10px;\">\n                        <h3 style=\"color: #10b981; font-size: 16px; margin-bottom: 10px;\">🟢 نقاط القوة</h3>\n                        <ul style=\"margin: 0; padding-right: 20px; color: #4b5563; font-size: 14px;\">\n                            {{ $('Code in JavaScript').item.json.strengths.map(item => `<li style=\"margin-bottom: 6px;\">${item}</li>`).join('') }}\n                        </ul>\n                    </td>\n                    <td width=\"50%\" style=\"vertical-align: top; padding-right: 10px; border-right: 1px solid #e5e7eb;\">\n                        <h3 style=\"color: #ef4444; font-size: 16px; margin-bottom: 10px;\">🔴 نقاط الضعف</h3>\n                        <ul style=\"margin: 0; padding-right: 20px; color: #4b5563; font-size: 14px;\">\n                            {{ $('Code in JavaScript').item.json.weaknesses.map(item => `<li style=\"margin-bottom: 6px;\">${item}</li>`).join('') }}\n                        </ul>\n                    </td>\n                </tr>\n            </table>\n\n            <!-- الافتراضات والأسئلة -->\n            <h2 style=\"color: #1e3a8a; font-size: 18px; border-bottom: 2px solid #e5e7eb; padding-bottom: 8px; margin-top: 30px;\">الافتراضات والأسئلة المفتوحة</h2>\n            <p><strong style=\"color: #8b5cf6;\">الافتراضات:</strong></p>\n            <ul style=\"margin-top: 5px; padding-right: 20px; color: #4b5563; font-size: 14px;\">\n                {{ $('Code in JavaScript').item.json.assumptions.map(item => `<li style=\"margin-bottom: 6px;\">${item}</li>`).join('') }}\n            </ul>\n            <p><strong style=\"color: #f97316;\">أسئلة تحتاج إجابة:</strong></p>\n            <ul style=\"margin-top: 5px; padding-right: 20px; color: #4b5563; font-size: 14px;\">\n                {{ $('Code in JavaScript').item.json.questions.map(item => `<li style=\"margin-bottom: 6px;\">${item}</li>`).join('') }}\n            </ul>\n\n            <!-- القرار النهائي -->\n            <div style=\"background-color: #eff6ff; border-right: 4px solid #3b82f6; padding: 20px; border-radius: 6px; margin-top: 30px;\">\n                <h3 style=\"color: #1e40af; margin-top: 0; font-size: 18px;\">القرار النهائي: {{ $('Code in JavaScript').item.json.verdict }}</h3>\n                <p style=\"margin-bottom: 0; color: #1e3a8a; font-size: 15px;\"><strong>السبب:</strong> {{ $('Code in JavaScript').item.json.verdictReason }}</p>\n            </div>\n\n        </div>\n        \n        <!-- التذييل -->\n        <div style=\"background-color: #f9fafb; color: #6b7280; text-align: center; padding: 15px; font-size: 12px; border-top: 1px solid #e5e7eb;\">\n            تم توليد هذا التقرير آلياً عبر نظام n8n\n        </div>\n    </div>\n</div>",
