    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n  // 1. جلب المخرجات من العقدة السابقة (AI Agent)\n  const rawOutput = item.json.output || \"\";\n  \n  // 2. تنظيف النص تحسباً لوجود علامات Markdown\n  const jsonString = rawOutput.replace(/```json/gi, '').replace(/```/g, '').trim();\n  \n  let data = {};\n  try {\n    data = JSON.parse(jsonString);\n  } catch (error) {\n    // في حال فشل التحليل، يتم إرجاع رسالة خطأ لمعرفة السبب\n    data = { error: \"Failed to parse JSON\", rawOutput };\n  }\n\n  // 3. دالة مساعدة لتصنيف التقييمات (Labels) بناءً على الرقم\n  const getScoreLabel = (value) => {\n    if (value >= 85) return \"Excellent\";\n    if (value >= 70) return \"Good\";\n    if (value >= 50) return \"Moderate\";\n    return \"Weak\";\n  };\n\n  // 4. بناء الهيكلية النهائية\n  results.push({\n    json: {\n      ideaName: data.idea_name || \"Startup Idea\",\n      title: \"Idea Analysis\",\n      summary: data.summary || \"\",\n      problem: data.problem || \"\",\n      solution: data.solution || \"\",\n      valueProposition: data.value_proposition || \"\",\n      targetCustomer: data.target_customer || \"\",\n      \n      // تحويل كائن التقييمات إلى مصفوفة (Array) مع تحسين شكل الأسماء\n      scores: data.scores ? Object.entries(data.scores).map(([key, value]) => ({\n        // تحويل 'market_potential' إلى 'Market Potential'\n        name: key.split('_').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' '),\n        value: value,\n        label: getScoreLabel(value)\n      })) : [],\n      \n      strengths: data.strengths || [],\n      weaknesses: data.weaknesses || [],\n      assumptions: data.assumptions || [],\n      questions: data.key_questions || [],\n      verdict: data.verdict || \"\",\n      verdictReason: data.verdict_reason || \"\"\n    }\n  });\n}\n\nreturn results;"
      },
